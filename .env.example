# ─────────────────────────── Base de datos (Supabase) ───────────────────────────
# Supabase → Project Settings → Database → Connection string
#
# DATABASE_URL: conexión POOLED (Transaction pooler, puerto 6543).
#   La usa la app en runtime. El parámetro pgbouncer=true es obligatorio:
#   desactiva los prepared statements, incompatibles con el pooler.
DATABASE_URL="postgresql://postgres.PROYECTO:CONTRASENA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: conexión DIRECTA (puerto 5432).
#   La usa el CLI de Prisma para migraciones. A través del pooler fallan.
DIRECT_URL="postgresql://postgres.PROYECTO:CONTRASENA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ─────────────────────────── Auth.js ───────────────────────────
# Generar con:  npx auth secret
AUTH_SECRET="reemplazar-por-un-secreto-largo-y-aleatorio"

# ─────────────────────────── Supabase Storage ───────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://PROYECTO.supabase.co"
# service_role: NUNCA exponerla al cliente. Solo se usa en el servidor.
SUPABASE_SERVICE_ROLE_KEY="reemplazar"

# Bucket privado donde se guardan los comprobantes de licencia.
SUPABASE_BUCKET_COMPROBANTES="comprobantes"
