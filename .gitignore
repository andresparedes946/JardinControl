# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# claude code: config local y skills vendorizadas (se reinstalan con skills-lock.json)
.claude/settings.local.json
.claude/skills/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# certificado autofirmado para probar cámara y GPS en un celular (npm run
# dev:https). Es de cada máquina y lleva su clave privada: nunca al repo.
/certificates

# service worker generado por Serwist
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
